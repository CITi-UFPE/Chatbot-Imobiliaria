# Anthropic
ANTHROPIC_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Segredo da Standby Key HS256 (Settings -> JWT Keys) usada pelo backend para
# assinar o JWT escopado por contrato do agente_ia. Ver docs/setup-supabase.md,
# seção 5 — nunca compartilhar esse valor fora do .env local.
SUPABASE_JWT_SECRET=

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App Secret do app Meta (não o access token) — usado para validar a
# assinatura X-Hub-Signature-256 dos POSTs do webhook. Sem isso configurado,
# o webhook aceita qualquer POST sem verificar que veio da Meta (ok em dev,
# obrigatório antes de produção).
WHATSAPP_APP_SECRET=
# Kill switch do cliente WhatsApp (app/tools/whatsapp_client.py). Enquanto
# não for exatamente "true" (case-insensitive; aceita também 1/yes/on),
# NENHUMA função de envio (texto/template/botões) faz chamada HTTP real —
# só loga e retorna resultado simulado. Nasce desligado de propósito: mais
# seguro exigir ligar explicitamente do que arriscar disparar mensagem real
# sem querer em dev/staging. Não afeta download de mídia (leitura de algo
# já recebido, não um envio).
WHATSAPP_ENVIO_ATIVO=false
# Versão da Graph API da Meta usada em toda URL montada por
# app/tools/whatsapp_client.py (ex: v21.0). Se não configurada, cai num
# padrão interno — mas prefira sempre fixar aqui, pra atualizar a versão
# sem precisar mexer em código quando a Meta depreciar a antiga.
WHATSAPP_GRAPH_API_VERSION=v21.0
# Tamanho máximo (em MB, aceita casas decimais) de um arquivo de mídia
# baixado por app/tools/whatsapp_client.py::baixar_midia (comprovantes de
# pagamento). Se não configurada ou inválida, cai no padrão de 10 MB. O
# download é abortado em streaming assim que ultrapassa esse limite, antes
# de acumular o arquivo inteiro na memória.
WHATSAPP_MIDIA_TAMANHO_MAXIMO_MB=10
# Telefone (formato E.164, ex: +5581999999999) que recebe os alertas de
# gestão contratual do A4 (renovação D-60, cálculo de reajuste D-30) —
# app/agents/a4_gestao_contratual/fluxo.py::_notificar_staff_alerta_contratual.
# Esses alertas são dirigidos À EQUIPE (Domingos/Fernanda decidem sobre
# renovação/reajuste), não ao inquilino — não confundir com
# WHATSAPP_PHONE_NUMBER_ID (o número do negócio) nem com o telefone do
# inquilino (que vem do próprio contrato). Só é exigido quando
# WHATSAPP_ENVIO_ATIVO=true; com o kill switch desligado, essa notificação
# nem chega a ser tentada.
WHATSAPP_STAFF_PHONE_NUMBER=

# Redis (Railway)
REDIS_URL=

# App
ENVIRONMENT=development
TIMEZONE=America/Recife

# CORS (API FastAPI) — separar múltiplas origens por vírgula
# Em dev não precisa setar (default: http://localhost:8080)
CORS_ALLOW_ORIGINS=
