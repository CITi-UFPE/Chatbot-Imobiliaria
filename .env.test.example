# Credenciais do projeto Supabase de TESTE — nunca o de produção.
# Copie para .env.test e preencha. tests/integration/conftest.py carrega
# ESTE arquivo explicitamente (não o .env de produção), então rodar a
# suíte de integração nunca fala com o banco real por engano, mesmo que
# .env já esteja carregado no ambiente.
#
# Setup do projeto: crie um projeto Supabase novo e separado (mesma região
# sa-east-1 do de produção — ver docs/setup-supabase.md), rode as
# migrations docs/schemas/001..021 em ordem, e preencha os valores abaixo
# a partir do dashboard desse projeto (mesmos lugares descritos em
# docs/setup-supabase.md, seção 4-5, só que apontando pro projeto de teste).

SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
# Mesmo mecanismo do SUPABASE_JWT_SECRET de produção (Standby Key HS256,
# "Import an existing secret") — só que gerado e configurado no projeto de
# TESTE. Nunca reutilizar o secret de produção aqui.
SUPABASE_TEST_JWT_SECRET=

# Connection string direta do Postgres (Settings -> Database -> Connection
# string -> URI, modo "Session pooler" ou direto) — usada SÓ para aplicar
# as migrations (docs/schemas/*.sql) via psql/script, nunca pela aplicação
# em si (que fala sempre REST/PostgREST via supabase-py, igual produção).
SUPABASE_TEST_DB_URL=

TIMEZONE=America/Recife
